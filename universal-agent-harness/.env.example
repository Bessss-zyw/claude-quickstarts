# Universal Agent Harness — Environment Configuration
# Copy this file to .env and fill in your API keys.
# Place .env next to your task.yaml, or in the harness source directory.

# ── NVIDIA Inference Hub ──────────────────────────────────────────
# Get your key at: https://inference.nvidia.com/key-management
# Base URL defaults to https://inference-api.nvidia.com/v1
# NVIDIA_BASE_URL=https://inference-api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-...

# ── OpenAI ────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── DeepSeek ──────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-...

# ── Custom provider ──────────────────────────────────────────────
# For provider "foo", set FOO_BASE_URL and FOO_API_KEY
# FOO_BASE_URL=https://api.foo.com/v1
# FOO_API_KEY=...
